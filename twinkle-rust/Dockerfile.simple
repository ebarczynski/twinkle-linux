# Simple Docker image for building Twinkle Linux with GTK4 support
FROM rust:1.82-slim

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install GTK4 and related dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libgtk-4-dev \
    libglib2.0-dev \
    libpango1.0-dev \
    libcairo2-dev \
    libatk1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libgraphene-1.0-dev \
    libadwaita-1-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace
