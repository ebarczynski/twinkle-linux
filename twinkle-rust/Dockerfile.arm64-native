# Docker image for building Twinkle Linux with GTK4 support (ARM64 native)
FROM debian:bookworm-slim

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build tools, GTK4 and related dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libgtk-4-dev \
    libglib2.0-dev \
    libpango1.0-dev \
    libcairo2-dev \
    libatk1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libgraphene-1.0-dev \
    libadwaita-1-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust using rustup (latest stable with edition2024 support)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /workspace
